# ==============================================================================
# MANVIA — Environment Configuration Template
# ==============================================================================
# NOTICE: This file contains sanitized placeholder variables for development
# and reference. NEVER commit real secrets, API keys, passwords, or tokens.
#
# To use:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'test' | 'staging' | 'production'
NODE_ENV=development
APP_NAME=manvia-backend
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting defaults (per IP)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Swagger / OpenAPI documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL + PGVECTOR) - Owned by Phase 3
# ------------------------------------------------------------------------------
# Connection URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manvia_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 4. CACHE & DISTRIBUTED LOCKS (REDIS) - Owned by Phase 2/3
# ------------------------------------------------------------------------------
# Redis connection string
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=manvia:
# Optional password if Redis requires auth
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY (JWT) - Owned by Phase 4
# ------------------------------------------------------------------------------
# CRITICAL: Use high-entropy random keys (minimum 32 characters) in real environments
JWT_SECRET=placeholder-jwt-secret-min-32-chars-for-dev-only
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=placeholder-jwt-refresh-secret-min-32-chars-for-dev-only
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE ABSTRACTION (OD-002) - Phase 2 Abstraction
# ------------------------------------------------------------------------------
# Driver: 'local' | 'minio' | 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_BUCKET=manvia-documents-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & TELEMETRY (OD-009) - OpenTelemetry
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=manvia-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY INTEGRATION PLACEHOLDERS (Future Phases)
# ------------------------------------------------------------------------------
# AI Provider (OD-003, Phase 15)
AI_PROVIDER=placeholder
AI_API_KEY=placeholder-ai-key

# Communications (OD-005, OD-006, OD-007, Phase 18)
SMS_PROVIDER=placeholder
EMAIL_PROVIDER=placeholder

# Payments (OD-004, Phase 19)
PAYMENT_GATEWAY=placeholder
PAYMENT_KEY_ID=placeholder
PAYMENT_KEY_SECRET=placeholder
