# ==============================================================================
# MANVIA — Production & Staging Environment Variable Specification (M8)
# ==============================================================================
# NOTICE: This template specifies all environment variables required across
# Development, Staging, and Production environments.
# Categorized into:
#   [INFRASTRUCTURE] [DATABASE] [AUTH] [SERVER_SECRET] [STORAGE] [PAYMENTS]
#   [AI] [REALTIME] [NOTIFICATIONS] [MONITORING] [PUBLIC]
#
# RULE: NEVER commit actual production secrets, passwords, or private keys.
# Production environments must provision secrets via Google Cloud Secret Manager
# or AWS Secrets Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & RUNTIME (INFRASTRUCTURE)
# ------------------------------------------------------------------------------
NODE_ENV=development                       # 'development' | 'staging' | 'production' | 'test'
PORT=3000                                 # Application listening port
HOST=0.0.0.0                              # Bind interface (0.0.0.0 for containerized deployment)
API_PREFIX=api/v1                         # Global API version prefix
LOG_LEVEL=debug                           # 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal'
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated production origin allowlist

# ------------------------------------------------------------------------------
# 2. DATABASE (DATABASE / SERVER_SECRET)
# ------------------------------------------------------------------------------
# PostgreSQL 18+ with pgvector extension enabled
DATABASE_URL=postgresql://postgres:password@localhost:5432/manvia_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED CACHE & LOCKING (INFRASTRUCTURE / SERVER_SECRET)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=manvia:
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (AUTH / SERVER_SECRET)
# ------------------------------------------------------------------------------
# In production, JWT secrets MUST be at least 32 cryptographically random characters
JWT_SECRET=placeholder-jwt-secret-min-32-chars-for-dev-only
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=placeholder-jwt-refresh-secret-min-32-chars-for-dev-only
JWT_REFRESH_EXPIRATION=30d

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (STORAGE / SERVER_SECRET)
# ------------------------------------------------------------------------------
# Development: 'local'. Production/Staging: 's3', 'minio', 'r2', or 'gcs'
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_BUCKET=manvia-documents-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=                         # Leave empty for standard AWS S3, set for MinIO/R2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. PAYMENTS & PAYOUTS (PAYMENTS / SERVER_SECRET)
# ------------------------------------------------------------------------------
# 'razorpay' or 'simulated'
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. AI & MEDICAL RAG (AI / SERVER_SECRET)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

AI_SAFETY_ENABLED=true
AI_SAFETY_PROVIDER=gemini
AI_SAFETY_MODEL=gemini-3.8-flash

RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.70
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# ------------------------------------------------------------------------------
# 8. REALTIME VOICE GATEWAY (REALTIME / SERVER_SECRET)
# ------------------------------------------------------------------------------
REALTIME_PROVIDER=gemini
REALTIME_MODEL=gemini-3.8-live

# ------------------------------------------------------------------------------
# 9. EXTERNAL NOTIFICATIONS (NOTIFICATIONS / SERVER_SECRET)
# ------------------------------------------------------------------------------
# Email: 'resend' or 'simulated'
EMAIL_PROVIDER=simulated
RESEND_API_KEY=
EMAIL_FROM=MANVIA Health <notifications@manvia.health>

# SMS: 'twilio' or 'simulated'
SMS_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push: 'fcm' or 'simulated'
PUSH_PROVIDER=simulated
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 10. MONITORING & OBSERVABILITY (MONITORING)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_SERVICE_NAME=manvia-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false

# ------------------------------------------------------------------------------
# 11. PUBLIC APPLICATION URLs (PUBLIC)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
MOBILE_APP_SCHEME=manvia
SWAGGER_ENABLED=true
SWAGGER_PATH=docs