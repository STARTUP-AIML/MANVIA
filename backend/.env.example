# ==============================================================================
# MANVIA — Environment Configuration Template
# ==============================================================================
# NOTICE: This file contains sanitized placeholder variables for development
# and reference. NEVER commit real secrets, API keys, passwords, or tokens.
#
# To use:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
LOG_LEVEL=debug

# -------------------------
# CORS& SECURITY
# -------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting defaults (per IP)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Swagger / OpenAPI documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# -------------------------
# DATABASE
# -------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/manvia_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -------------------------
# REDIS
# -------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=manvia:
REDIS_PASSWORD=

# -------------------------
# AUTHENTICATION
# -------------------------
JWT_SECRET=placeholder-jwt-secret-min-32-chars-for-dev-only
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=placeholder-jwt-refresh-secret-min-32-chars-for-dev-only
JWT_REFRESH_EXPIRATION=30d

# -------------------------
# STORAGE
# -------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_BUCKET=manvia-documents-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# -------------------------
# AI
# -------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=placeholder
GEMINI_MODEL=gemini-3.8-flash

# -------------------------
# AI SAFETY
# -------------------------
AI_SAFETY_ENABLED=true
AI_SAFETY_PROVIDER=gemini
AI_SAFETY_MODEL=gemini-3.8-flash

# -------------------------
# MEDICAL RAG
# -------------------------
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.70

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# -------------------------
# REALTIME AI
# -------------------------
REALTIME_PROVIDER=gemini
REALTIME_MODEL=gemini-3.8-live

# -------------------------
# PAYMENTS
# -------------------------
PAYMENT_PROVIDER=razorpay

RAZORPAY_KEY_ID=placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# -------------------------
# EMAIL
# -------------------------
EMAIL_PROVIDER=placeholder
RESEND_API_KEY=
EMAIL_FROM=

# -------------------------
# SMS
# -------------------------
SMS_PROVIDER=placeholder
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------
# PUSH NOTIFICATIONS
# -------------------------
PUSH_PROVIDER=fcm
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -------------------------
# OBSERVABILITY
# -------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

OTEL_SERVICE_NAME=manvia-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false

# -------------------------
# APP URLs
# -------------------------
FRONTEND_URL=http://localhost:5173
MOBILE_APP_SCHEME=manvia