// ==============================================================================
// MANVIA — Prisma Schema (Phases 0–10 Cumulative Platform Foundation)
// ==============================================================================
// Baseline:
// - PostgreSQL 18.x
// - Prisma 7.x
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// Identity & Authentication Boundary (Phase 4 Foundation)
// ------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  LOCKED
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique @db.VarChar(320)
  phone               String?             @unique @db.VarChar(32)
  emailVerified       Boolean             @default(false) @map("email_verified")
  phoneVerified       Boolean             @default(false) @map("phone_verified")
  status              UserStatus          @default(ACTIVE)
  roles               Role[]              @default([PATIENT])
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?           @map("lockout_until") @db.Timestamptz
  lastLoginAt         DateTime?           @map("last_login_at") @db.Timestamptz
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  passwordCredential  PasswordCredential?
  sessions            Session[]
  auditLogs           AuditLog[]
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  aiConversations     AIConversation[]
  aiFeedbacks         AIMessageFeedback[]
  aiSafetyEvents      AISafetyEvent[]
  aiMemories          AIMemory[]
  aiRealtimeSessions  AIRealtimeSession[]
  aiHumanHandoffs     AIHumanHandoff[]

  @@map("users")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.Text
  deviceType     String?        @map("device_type") @db.VarChar(32)
  deviceName     String?        @map("device_name") @db.VarChar(128)
  lastActivityAt DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  status       String   @db.VarChar(20)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// Patient Domain (Phase 6 Foundation + Phase 10 Extensions)
// ------------------------------------------------------------------------------

enum BiologicalSex {
  MALE
  FEMALE
  INTERSEX
  OTHER
}

model PatientProfile {
  id                           String             @id @default(uuid()) @db.Uuid
  userId                       String             @unique @map("user_id") @db.Uuid
  publicPatientId              String             @unique @map("public_patient_id") @db.VarChar(32)
  legalFirstName               String?            @map("legal_first_name") @db.VarChar(100)
  legalLastName                String?            @map("legal_last_name") @db.VarChar(100)
  displayName                  String?            @map("display_name") @db.VarChar(150)
  dateOfBirth                  DateTime?          @map("date_of_birth") @db.Date
  gender                       String?            @db.VarChar(30)
  biologicalSex                BiologicalSex?     @map("biological_sex")
  bloodGroup                   String?            @map("blood_group") @db.VarChar(10)
  emergencyContactName         String?            @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone        String?            @map("emergency_contact_phone") @db.VarChar(32)
  emergencyContactRelationship String?            @map("emergency_contact_relationship") @db.VarChar(50)
  preferredLanguage            String             @default("en") @map("preferred_language") @db.VarChar(10)
  timezone                     String             @default("UTC") @db.VarChar(64)
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user                         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  careRelationships            CareRelationship[]
  consents                     Consent[]
  wellnessCheckIns             WellnessCheckIn[]
  healthRecords                HealthRecord[]
  timelineEvents               TimelineEvent[]
  appointments                 Appointment[]
  preConsultations             PreConsultation[]

  @@index([publicPatientId])
  @@map("patient_profiles")
}

// ------------------------------------------------------------------------------
// Doctor Platform Verification Lifecycle (Phase 7 Baseline)
// ------------------------------------------------------------------------------

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

// ------------------------------------------------------------------------------
// Doctor Profile (Phase 7)
// ------------------------------------------------------------------------------

model DoctorProfile {
  id                        String                @id @default(uuid()) @db.Uuid
  userId                    String                @unique @map("user_id") @db.Uuid
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  publicDoctorId            String                @unique @map("public_doctor_id") @db.VarChar(16)
  displayName               String                @map("display_name") @db.VarChar(150)
  bio                       String?               @db.Text
  medicalRegistrationNumber String                @unique @map("medical_registration_number") @db.VarChar(64)
  licensingCouncil          String                @map("licensing_council") @db.VarChar(128)
  yearsOfExperience         Int                   @default(0) @map("years_of_experience")
  verificationStatus        VerificationStatus    @default(DRAFT) @map("verification_status")
  defaultConsultationFee    Decimal               @default(0.00) @map("default_consultation_fee") @db.Decimal(10, 2)
  currency                  String                @default("USD") @db.VarChar(3)
  verifiedAt                DateTime?             @map("verified_at") @db.Timestamptz(6)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  specialties               DoctorSpecialty[]
  languages                 DoctorLanguage[]
  qualifications            DoctorQualification[]
  verifications             DoctorVerification[]
  availabilities            DoctorAvailability[]
  consultationOffers        ConsultationOffer[]
  careRelationships         CareRelationship[]
  consents                  Consent[]
  appointments              Appointment[]
  aiHandoffs                AIHumanHandoff[]

  @@index([publicDoctorId])
  @@index([verificationStatus])
  @@index([medicalRegistrationNumber])
  @@map("doctor_profiles")
}

// ------------------------------------------------------------------------------
// Medical Specialty Taxonomy & Relations (Phase 7)
// ------------------------------------------------------------------------------

model Specialty {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(50)
  name        String            @unique @db.VarChar(100)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctors     DoctorSpecialty[]

  @@index([code])
  @@index([isActive])
  @@map("specialties")
}

model DoctorSpecialty {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @map("doctor_id") @db.Uuid
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialtyId String        @map("specialty_id") @db.Uuid
  specialty   Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  isPrimary   Boolean       @default(false) @map("is_primary")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([doctorId, specialtyId], name: "doctor_specialty_unique")
  @@index([doctorId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

// ------------------------------------------------------------------------------
// Language Taxonomy & Relations (Phase 7)
// ------------------------------------------------------------------------------

model Language {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(10)
  name      String           @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctors   DoctorLanguage[]

  @@index([code])
  @@map("languages")
}

model DoctorLanguage {
  id         String        @id @default(uuid()) @db.Uuid
  doctorId   String        @map("doctor_id") @db.Uuid
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  languageId String        @map("language_id") @db.Uuid
  language   Language      @relation(fields: [languageId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([doctorId, languageId], name: "doctor_language_unique")
  @@index([doctorId])
  @@index([languageId])
  @@map("doctor_languages")
}

// ------------------------------------------------------------------------------
// Doctor Qualifications (Phase 7)
// ------------------------------------------------------------------------------

model DoctorQualification {
  id             String        @id @default(uuid()) @db.Uuid
  doctorId       String        @map("doctor_id") @db.Uuid
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  qualification  String        @db.VarChar(100)
  institution    String        @db.VarChar(200)
  fieldOfStudy   String?       @map("field_of_study") @db.VarChar(100)
  graduationYear Int?          @map("graduation_year")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId])
  @@map("doctor_qualifications")
}

// ------------------------------------------------------------------------------
// Doctor Verification Domain (Phase 8: Controlled Administrative Workflow)
// ------------------------------------------------------------------------------

enum DoctorVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VerificationDocumentType {
  MEDICAL_LICENSE
  DEGREE_CERTIFICATE
  GOVERNMENT_ID
  MALPRACTICE_INSURANCE
  OTHER
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum ReviewAction {
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

model DoctorVerification {
  id              String                   @id @default(uuid()) @db.Uuid
  doctorId        String                   @map("doctor_id") @db.Uuid
  doctor          DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status          DoctorVerificationStatus @default(DRAFT)
  submissionNotes String?                  @map("submission_notes") @db.Text
  rejectionReason String?                  @map("rejection_reason") @db.Text
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String?                  @map("reviewed_by") @db.VarChar(128)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents       VerificationDocument[]
  reviews         VerificationReview[]

  @@index([doctorId])
  @@index([status])
  @@index([submittedAt])
  @@map("doctor_verifications")
}

model VerificationDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  verificationId   String                   @map("verification_id") @db.Uuid
  verification     DoctorVerification       @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType     VerificationDocumentType @map("document_type")
  storageKey       String                   @unique @map("storage_key") @db.VarChar(255)
  originalFileName String                   @map("original_file_name") @db.VarChar(255)
  mimeType         String                   @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int                      @map("file_size_bytes")
  status           DocumentStatus           @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([verificationId])
  @@index([documentType])
  @@map("verification_documents")
}

model VerificationReview {
  id              String             @id @default(uuid()) @db.Uuid
  verificationId  String             @map("verification_id") @db.Uuid
  verification    DoctorVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  reviewerAdminId String             @map("reviewer_admin_id") @db.VarChar(128)
  action          ReviewAction
  reason          String?            @db.Text
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([verificationId])
  @@index([reviewerAdminId])
  @@index([createdAt])
  @@map("verification_reviews")
}

// ------------------------------------------------------------------------------
// Doctor Availability & Consultation Offers (Phase 9: Provider Scheduling Foundation)
// ------------------------------------------------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ConsultationType {
  INITIAL
  FOLLOW_UP
  GENERAL
  SPECIALIST
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model DoctorAvailability {
  id             String        @id @default(uuid()) @db.Uuid
  doctorId       String        @map("doctor_id") @db.Uuid
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  timezone       String        @db.VarChar(64)
  dayOfWeek      DayOfWeek     @map("day_of_week")
  startTime      String        @map("start_time") @db.VarChar(5)
  endTime        String        @map("end_time") @db.VarChar(5)
  effectiveFrom  DateTime?     @map("effective_from") @db.Date
  effectiveUntil DateTime?     @map("effective_until") @db.Date
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId])
  @@index([doctorId, isActive])
  @@index([doctorId, dayOfWeek])
  @@map("doctor_availabilities")
}

model ConsultationOffer {
  id               String           @id @default(uuid()) @db.Uuid
  doctorId         String           @map("doctor_id") @db.Uuid
  doctor           DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title            String           @db.VarChar(150)
  description      String?          @db.Text
  consultationType ConsultationType @default(GENERAL) @map("consultation_type")
  durationMinutes  Int              @map("duration_minutes")
  fee              Decimal          @db.Decimal(10, 2)
  currency         String           @default("USD") @db.VarChar(3)
  status           OfferStatus      @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments     Appointment[]

  @@index([doctorId])
  @@index([doctorId, status])
  @@index([consultationType])
  @@map("consultation_offers")
}

// ------------------------------------------------------------------------------
// Care Relationships & Consent Domain (Phase 10: Authorization & Controlled Access)
// ------------------------------------------------------------------------------

enum CareRelationshipStatus {
  REQUESTED
  ACTIVE
  SUSPENDED
  TERMINATED
  REVOKED
}

model CareRelationship {
  id            String                 @id @default(uuid()) @db.Uuid
  patientId     String                 @map("patient_id") @db.Uuid
  patient       PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String                 @map("doctor_id") @db.Uuid
  doctor        DoctorProfile          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status        CareRelationshipStatus @default(ACTIVE)
  establishedAt DateTime?              @map("established_at") @db.Timestamptz(6)
  terminatedAt  DateTime?              @map("terminated_at") @db.Timestamptz(6)
  notes         String?                @db.Text
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  consents      Consent[]

  @@unique([patientId, doctorId], name: "patient_doctor_unique")
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([patientId, doctorId, status])
  @@map("care_relationships")
}

enum ConsentScope {
  PATIENT_PROFILE
  CONSULTATION_INFO
  PRE_CONSULTATION
  HEALTH_RECORDS
  HEALTH_TIMELINE
  WELLNESS
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ConsentAction {
  GRANTED
  REVOKED
  EXPIRED
  SCOPE_UPDATED
}

model Consent {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  patient            PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String            @map("doctor_id") @db.Uuid
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  careRelationshipId String?           @map("care_relationship_id") @db.Uuid
  careRelationship   CareRelationship? @relation(fields: [careRelationshipId], references: [id], onDelete: SetNull)
  scope              ConsentScope
  status             ConsentStatus     @default(ACTIVE)
  purpose            String?           @db.Text
  grantedAt          DateTime          @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt          DateTime?         @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedBy          String?           @map("revoked_by") @db.VarChar(128)
  revocationReason   String?           @map("revocation_reason") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  history            ConsentHistory[]

  @@index([patientId])
  @@index([doctorId])
  @@index([careRelationshipId])
  @@index([patientId, doctorId, scope, status])
  @@index([status])
  @@index([expiresAt])
  @@map("consents")
}

model ConsentHistory {
  id        String        @id @default(uuid()) @db.Uuid
  consentId String        @map("consent_id") @db.Uuid
  consent   Consent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  action    ConsentAction
  actorId   String        @map("actor_id") @db.VarChar(128)
  actorRole String        @map("actor_role") @db.VarChar(50)
  reason    String?       @db.Text
  metadata  String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consentId])
  @@index([actorId])
  @@index([createdAt])
}


// ------------------------------------------------------------------------------
// Wellness Engine Domain (Phase 11: Patient Non-Diagnostic Wellness & Trends)
// ------------------------------------------------------------------------------

model WellnessCheckIn {
  id                   String         @id @default(uuid()) @db.Uuid
  patientId            String         @map("patient_id") @db.Uuid
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mood                 Int            // 1-5 scale (1: Very Low, 2: Low, 3: Fair, 4: Good, 5: Excellent)
  stress               Int            // 1-5 scale (1: Very Low, 2: Low, 3: Moderate, 4: High, 5: Very High)
  energy               Int            // 1-5 scale (1: Very Low, 2: Low, 3: Moderate, 4: High, 5: Very High)
  sleepQuality         Int            @map("sleep_quality") // 1-5 scale (1: Very Poor, 2: Poor, 3: Fair, 4: Good, 5: Excellent)
  sleepDurationMinutes Int?           @map("sleep_duration_minutes") // Optional recorded sleep duration in minutes
  note                 String?        @db.Text // Optional personal wellness journal/reflection entry
  recordedAt           DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([patientId, recordedAt])
  @@map("wellness_check_ins")
}

// ------------------------------------------------------------------------------
// Health Records & Health Timeline Domain (Phase 12)
// ------------------------------------------------------------------------------

enum HealthRecordCategory {
  LAB_REPORT
  PRESCRIPTION
  CLINICAL_SUMMARY
  IMAGING
  DISCHARGE_SUMMARY
  OTHER
}

enum HealthRecordStatus {
  PENDING
  AVAILABLE
  ARCHIVED
  DELETED
}

model HealthRecord {
  id               String               @id @default(uuid()) @db.Uuid
  publicRecordId   String               @unique @map("public_record_id") @db.VarChar(32)
  patientId        String               @map("patient_id") @db.Uuid
  patient          PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  category         HealthRecordCategory
  title            String               @db.VarChar(200)
  description      String?              @db.Text
  storageKey       String               @unique @map("storage_key") @db.VarChar(512)
  originalFileName String               @map("original_file_name") @db.VarChar(255)
  mimeType         String               @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int                  @map("file_size_bytes")
  sha256Hash       String?              @map("sha256_hash") @db.VarChar(64)
  status           HealthRecordStatus   @default(AVAILABLE)
  recordedDate     DateTime             @map("recorded_date") @db.Date
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([patientId, recordedDate])
  @@index([category])
  @@index([status])
  @@map("health_records")
}

enum TimelineEventType {
  HEALTH_RECORD_ADDED
  WELLNESS_CHECK_IN
  CONSULTATION
  APPOINTMENT
  OTHER
}

model TimelineEvent {
  id             String            @id @default(uuid()) @db.Uuid
  publicEventId  String            @unique @map("public_event_id") @db.VarChar(32)
  patientId      String            @map("patient_id") @db.Uuid
  patient        PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventType      TimelineEventType @map("event_type")
  title          String            @db.VarChar(200)
  summary        String            @db.Text
  sourceType     String            @map("source_type") @db.VarChar(50)
  sourceId       String?           @map("source_id") @db.VarChar(128)
  eventTimestamp DateTime          @map("event_timestamp") @db.Timestamptz(6)
  metadata       String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([patientId, eventTimestamp(sort: Desc)])
  @@index([eventType])
  @@index([sourceType, sourceId])
  @@map("timeline_events")
}

// ------------------------------------------------------------------------------
// Pre-consultation + Appointment Engine Domain (Phase 13)
// ------------------------------------------------------------------------------

enum AppointmentStatus {
  RESERVED
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
  EXPIRED
  NO_SHOW
}

enum SlotReservationState {
  AVAILABLE
  HELD_IN_RESERVATION
  BOOKED
}

enum PreConsultationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

model Appointment {
  id                  String               @id @default(uuid()) @db.Uuid
  publicAppointmentId String               @unique @map("public_appointment_id") @db.VarChar(32)
  patientId           String               @map("patient_id") @db.Uuid
  patient             PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String               @map("doctor_id") @db.Uuid
  doctor              DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultationOfferId String               @map("consultation_offer_id") @db.Uuid
  consultationOffer   ConsultationOffer    @relation(fields: [consultationOfferId], references: [id], onDelete: Restrict)
  startAt             DateTime             @map("start_at") @db.Timestamptz(6)
  endAt               DateTime             @map("end_at") @db.Timestamptz(6)
  status              AppointmentStatus    @default(REQUESTED)
  reservationState    SlotReservationState @default(BOOKED) @map("reservation_state")
  reservedUntil       DateTime?            @map("reserved_until") @db.Timestamptz(6)
  cancellationReason  String?              @map("cancellation_reason") @db.Text
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?              @map("cancelled_by") @db.VarChar(128)
  declineReason       String?              @map("decline_reason") @db.Text
  declinedAt          DateTime?            @map("declined_at") @db.Timestamptz(6)
  confirmedAt         DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  startedAt           DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(6)
  noShowAt            DateTime?            @map("no_show_at") @db.Timestamptz(6)
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  preConsultation     PreConsultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationOfferId])
  @@index([startAt])
  @@index([status])
  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model PreConsultation {
  id                 String                @id @default(uuid()) @db.Uuid
  appointmentId      String                @unique @map("appointment_id") @db.Uuid
  appointment        Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId          String                @map("patient_id") @db.Uuid
  patient            PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status             PreConsultationStatus @default(NOT_STARTED)
  reasonForVisit     String                @map("reason_for_visit") @db.VarChar(1000)
  symptoms           String?               @db.Text
  symptomOnset       String?               @map("symptom_onset") @db.VarChar(100)
  currentMedications String?               @map("current_medications") @db.Text
  allergies          String?               @db.Text
  patientNotes       String?               @map("patient_notes") @db.Text
  submittedAt        DateTime?             @map("submitted_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
  @@map("pre_consultations")
}

// ------------------------------------------------------------------------------
// AI Companion Boundary (Phase 15 Core Foundation)
// ------------------------------------------------------------------------------

enum AIConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIMessageStatus {
  SENT
  DELIVERED
  FAILED
}

enum AIFeedbackRating {
  POSITIVE
  NEGATIVE
}

model AIConversation {
  id                   String               @id @default(uuid()) @db.Uuid
  publicConversationId String               @unique @map("public_conversation_id") @db.VarChar(16)
  userId               String               @map("user_id") @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String               @db.VarChar(255)
  status               AIConversationStatus @default(ACTIVE)
  lastMessageAt        DateTime             @default(now()) @map("last_message_at") @db.Timestamptz(6)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages             AIMessage[]
  safetyEvents         AISafetyEvent[]
  humanHandoffs        AIHumanHandoff[]

  @@index([userId])
  @@index([userId, status])
  @@index([lastMessageAt])
  @@map("ai_conversations")
}

model AIMessage {
  id              String               @id @default(uuid()) @db.Uuid
  publicMessageId String               @unique @map("public_message_id") @db.VarChar(16)
  conversationId  String               @map("conversation_id") @db.Uuid
  conversation    AIConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            AIMessageRole
  content         String               @db.Text
  status          AIMessageStatus      @default(SENT)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  generation      AIMessageGeneration?
  feedbacks       AIMessageFeedback[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIMessageGeneration {
  id               String    @id @default(uuid()) @db.Uuid
  messageId        String    @unique @map("message_id") @db.Uuid
  message          AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  provider         String    @db.VarChar(64)
  model            String    @db.VarChar(64)
  latencyMs        Int       @map("latency_ms")
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  totalTokens      Int       @default(0) @map("total_tokens")
  finishReason     String?   @map("finish_reason") @db.VarChar(64)
  correlationId    String?   @map("correlation_id") @db.VarChar(64)
  isAiGenerated    Boolean   @default(true) @map("is_ai_generated")
  disclosureNotice String    @map("disclosure_notice") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_message_generations")
}

model AIMessageFeedback {
  id        String           @id @default(uuid()) @db.Uuid
  messageId String           @map("message_id") @db.Uuid
  message   AIMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    AIFeedbackRating
  comment   String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("ai_message_feedbacks")
}

// ------------------------------------------------------------------------------
// AI Companion Phase 16 & 17: Medical RAG, AI Safety, Memory, Realtime & Handoff
// ------------------------------------------------------------------------------

enum AISafetyClassification {
  SAFE
  MEDICAL_INFORMATION
  POTENTIALLY_HARMFUL
  URGENT_MEDICAL
  CRISIS
  SELF_HARM_OR_SUICIDE
  EMERGENCY
  UNSUPPORTED_CLINICAL_REQUEST
}

enum AISafetyAction {
  ALLOWED
  FLAGGED
  DISCLOSURE_ATTACHED
  REFUSAL
  EMERGENCY_ESCALATION
  CRISIS_REFERRAL
}

enum AIMemoryCategory {
  PREFERENCE
  COMMUNICATION_STYLE
  WELLNESS_GOAL
  PERSONALIZATION
}

enum AIMemoryStatus {
  ACTIVE
  ARCHIVED
}

enum AIRealtimeState {
  IDLE
  LISTENING
  PROCESSING
  SPEAKING
  INTERRUPTED
  MUTED
  PAUSED
  RECONNECTING
  ERROR
  HANDOFF_TO_HUMAN
  ENDED
}

enum AIHandoffStatus {
  REQUESTED
  QUEUED
  ASSIGNED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum AIHandoffUrgency {
  ROUTINE
  URGENT
  CRISIS
}

model AIMedicalSource {
  id              String              @id @default(uuid()) @db.Uuid
  publicSourceId  String              @unique @map("public_source_id") @db.VarChar(16)
  title           String              @db.VarChar(255)
  organization    String              @db.VarChar(255)
  sourceType      String              @map("source_type") @db.VarChar(64)
  version         String?             @db.VarChar(64)
  publicationDate DateTime?           @map("publication_date") @db.Timestamptz(6)
  trustStatus     String              @default("VERIFIED") @map("trust_status") @db.VarChar(32)
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents       AIMedicalDocument[]

  @@index([publicSourceId])
  @@index([isActive])
  @@map("ai_medical_sources")
}

model AIMedicalDocument {
  id                 String          @id @default(uuid()) @db.Uuid
  sourceId           String          @map("source_id") @db.Uuid
  source             AIMedicalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentIdentifier String          @map("document_identifier") @db.VarChar(128)
  title              String          @db.VarChar(255)
  chunkCount         Int             @default(0) @map("chunk_count")
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  chunks             AIMedicalChunk[]

  @@unique([sourceId, documentIdentifier])
  @@index([sourceId])
  @@map("ai_medical_documents")
}

model AIMedicalChunk {
  id              String            @id @default(uuid()) @db.Uuid
  documentId      String            @map("document_id") @db.Uuid
  document        AIMedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIdentifier String            @map("chunk_identifier") @db.VarChar(128)
  content         String            @db.Text
  keywords        String[]          @default([])
  relevanceScore  Float?            @map("relevance_score")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId])
  @@map("ai_medical_chunks")
}

model AISafetyEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  publicEventId   String                 @unique @map("public_event_id") @db.VarChar(16)
  userId          String                 @map("user_id") @db.Uuid
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?                @map("conversation_id") @db.Uuid
  conversation    AIConversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  classification  AISafetyClassification
  actionTaken     AISafetyAction         @map("action_taken")
  confidenceScore Float?                 @map("confidence_score")
  matchedRules    String[]               @default([]) @map("matched_rules")
  locale          String                 @default("en-US") @db.VarChar(16)
  metadata        Json?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([conversationId])
  @@index([classification])
  @@index([createdAt])
  @@map("ai_safety_events")
}

model AIMemory {
  id             String           @id @default(uuid()) @db.Uuid
  publicMemoryId String           @unique @map("public_memory_id") @db.VarChar(16)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       AIMemoryCategory
  key            String           @db.VarChar(128)
  value          String           @db.Text
  confidence     Float            @default(1.0)
  source         String           @default("USER_EXPLICIT") @db.VarChar(64)
  status         AIMemoryStatus   @default(ACTIVE)
  isUserApproved Boolean          @default(true) @map("is_user_approved")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, category, key])
  @@index([userId])
  @@index([userId, status])
  @@map("ai_memories")
}

model AIRealtimeSession {
  id                String          @id @default(uuid()) @db.Uuid
  publicSessionId   String          @unique @map("public_session_id") @db.VarChar(16)
  userId            String          @map("user_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String          @db.VarChar(64)
  model             String          @db.VarChar(64)
  state             AIRealtimeState @default(IDLE)
  connectionInfo    Json?           @map("connection_info")
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  interruptionCount Int             @default(0) @map("interruption_count")
  reconnectCount    Int             @default(0) @map("reconnect_count")
  totalLatencyMs    Int             @default(0) @map("total_latency_ms")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, state])
  @@index([expiresAt])
  @@map("ai_realtime_sessions")
}

model AIHumanHandoff {
  id               String           @id @default(uuid()) @db.Uuid
  publicHandoffId  String           @unique @map("public_handoff_id") @db.VarChar(16)
  userId           String           @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?          @map("conversation_id") @db.Uuid
  conversation     AIConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedDoctorId String?          @map("assigned_doctor_id") @db.Uuid
  assignedDoctor   DoctorProfile?   @relation(fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  reason           String           @db.VarChar(128)
  safetyLevel      String           @default("ROUTINE") @map("safety_level") @db.VarChar(32)
  requestedUrgency AIHandoffUrgency @default(ROUTINE) @map("requested_urgency")
  status           AIHandoffStatus  @default(REQUESTED)
  userSummary      String?          @map("user_summary") @db.Text
  consentGranted   Boolean          @default(false) @map("consent_granted")
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([assignedDoctorId])
  @@index([status])
  @@index([conversationId])
  @@map("ai_human_handoffs")
}


