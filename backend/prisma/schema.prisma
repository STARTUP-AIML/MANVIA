// ==============================================================================
// MANVIA — Prisma Schema (Phase 7: Doctor Platform Domain)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Identity & User Boundary (Phase 4 owns full user credential/session models)
// ------------------------------------------------------------------------------
model User {
  id             String          @id @default(uuid()) @db.Uuid
  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?

  @@map("users")
}

// ------------------------------------------------------------------------------
// Doctor Platform Verification Lifecycle
// ------------------------------------------------------------------------------
enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

// ------------------------------------------------------------------------------
// Doctor Profile
// ------------------------------------------------------------------------------
model DoctorProfile {
  id                        String                @id @default(uuid()) @db.Uuid
  userId                    String                @unique @map("user_id") @db.Uuid
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  publicDoctorId            String                @unique @map("public_doctor_id") @db.VarChar(16)
  displayName               String                @map("display_name") @db.VarChar(150)
  bio                       String?               @db.Text
  medicalRegistrationNumber String                @unique @map("medical_registration_number") @db.VarChar(64)
  licensingCouncil          String                @map("licensing_council") @db.VarChar(128)
  yearsOfExperience         Int                   @default(0) @map("years_of_experience")
  verificationStatus        VerificationStatus    @default(DRAFT) @map("verification_status")
  defaultConsultationFee    Decimal               @default(0.00) @map("default_consultation_fee") @db.Decimal(10, 2)
  currency                  String                @default("USD") @db.VarChar(3)
  verifiedAt                DateTime?             @map("verified_at") @db.Timestamptz(6)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  specialties               DoctorSpecialty[]
  languages                 DoctorLanguage[]
  qualifications            DoctorQualification[]
  verifications             DoctorVerification[]
  availabilities            DoctorAvailability[]
  consultationOffers        ConsultationOffer[]
  careRelationships         CareRelationship[]
  consents                  Consent[]

  @@index([publicDoctorId])
  @@index([verificationStatus])
  @@index([medicalRegistrationNumber])
  @@map("doctor_profiles")
}

// ------------------------------------------------------------------------------
// Medical Specialty Taxonomy & Relations
// ------------------------------------------------------------------------------
model Specialty {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(50)
  name        String            @unique @db.VarChar(100)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctors     DoctorSpecialty[]

  @@index([code])
  @@index([isActive])
  @@map("specialties")
}

model DoctorSpecialty {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @map("doctor_id") @db.Uuid
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialtyId String        @map("specialty_id") @db.Uuid
  specialty   Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  isPrimary   Boolean       @default(false) @map("is_primary")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([doctorId, specialtyId], name: "doctor_specialty_unique")
  @@index([doctorId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

// ------------------------------------------------------------------------------
// Language Taxonomy & Relations
// ------------------------------------------------------------------------------
model Language {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(10)
  name      String           @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctors   DoctorLanguage[]

  @@index([code])
  @@map("languages")
}

model DoctorLanguage {
  id         String        @id @default(uuid()) @db.Uuid
  doctorId   String        @map("doctor_id") @db.Uuid
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  languageId String        @map("language_id") @db.Uuid
  language   Language      @relation(fields: [languageId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([doctorId, languageId], name: "doctor_language_unique")
  @@index([doctorId])
  @@index([languageId])
  @@map("doctor_languages")
}

// ------------------------------------------------------------------------------
// Doctor Qualifications
// ------------------------------------------------------------------------------
model DoctorQualification {
  id             String        @id @default(uuid()) @db.Uuid
  doctorId       String        @map("doctor_id") @db.Uuid
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  qualification  String        @db.VarChar(100)
  institution    String        @db.VarChar(200)
  fieldOfStudy   String?       @map("field_of_study") @db.VarChar(100)
  graduationYear Int?          @map("graduation_year")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId])
  @@map("doctor_qualifications")
}

// ------------------------------------------------------------------------------
// Doctor Verification Domain (Phase 8: Controlled Administrative Workflow)
// ------------------------------------------------------------------------------

enum DoctorVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VerificationDocumentType {
  MEDICAL_LICENSE
  DEGREE_CERTIFICATE
  GOVERNMENT_ID
  MALPRACTICE_INSURANCE
  OTHER
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum ReviewAction {
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

model DoctorVerification {
  id              String                   @id @default(uuid()) @db.Uuid
  doctorId        String                   @map("doctor_id") @db.Uuid
  doctor          DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status          DoctorVerificationStatus @default(DRAFT)
  submissionNotes String?                  @map("submission_notes") @db.Text
  rejectionReason String?                  @map("rejection_reason") @db.Text
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String?                  @map("reviewed_by") @db.VarChar(128)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents       VerificationDocument[]
  reviews         VerificationReview[]

  @@index([doctorId])
  @@index([status])
  @@index([submittedAt])
  @@map("doctor_verifications")
}

model VerificationDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  verificationId   String                   @map("verification_id") @db.Uuid
  verification     DoctorVerification       @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType     VerificationDocumentType @map("document_type")
  storageKey       String                   @unique @map("storage_key") @db.VarChar(255)
  originalFileName String                   @map("original_file_name") @db.VarChar(255)
  mimeType         String                   @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int                      @map("file_size_bytes")
  status           DocumentStatus           @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([verificationId])
  @@index([documentType])
  @@map("verification_documents")
}

model VerificationReview {
  id              String             @id @default(uuid()) @db.Uuid
  verificationId  String             @map("verification_id") @db.Uuid
  verification    DoctorVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  reviewerAdminId String             @map("reviewer_admin_id") @db.VarChar(128)
  action          ReviewAction
  reason          String?            @db.Text
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([verificationId])
  @@index([reviewerAdminId])
  @@index([createdAt])
  @@map("verification_reviews")
}

// ------------------------------------------------------------------------------
// Doctor Availability & Consultation Offers (Phase 9: Provider Scheduling Foundation)
// ------------------------------------------------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ConsultationType {
  INITIAL
  FOLLOW_UP
  GENERAL
  SPECIALIST
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model DoctorAvailability {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  timezone       String    @db.VarChar(64)
  dayOfWeek      DayOfWeek @map("day_of_week")
  startTime      String    @map("start_time") @db.VarChar(5)
  endTime        String    @map("end_time") @db.VarChar(5)
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId])
  @@index([doctorId, isActive])
  @@index([doctorId, dayOfWeek])
  @@map("doctor_availabilities")
}

model ConsultationOffer {
  id               String           @id @default(uuid()) @db.Uuid
  doctorId         String           @map("doctor_id") @db.Uuid
  doctor           DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title            String           @db.VarChar(150)
  description      String?          @db.Text
  consultationType ConsultationType @default(GENERAL) @map("consultation_type")
  durationMinutes  Int              @map("duration_minutes")
  fee              Decimal          @db.Decimal(10, 2)
  currency         String           @default("USD") @db.VarChar(3)
  status           OfferStatus      @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId])
  @@index([doctorId, status])
  @@index([consultationType])
  @@map("consultation_offers")
}

// ------------------------------------------------------------------------------
// Care Relationships & Consent Domain (Phase 10: Authorization & Controlled Access)
// ------------------------------------------------------------------------------

model PatientProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @map("user_id") @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  publicPatientId       String            @unique @map("public_patient_id") @db.VarChar(16)
  legalFirstName        String            @map("legal_first_name") @db.VarChar(100)
  legalLastName         String            @map("legal_last_name") @db.VarChar(100)
  displayName           String?           @map("display_name") @db.VarChar(150)
  dateOfBirth           DateTime?         @map("date_of_birth") @db.Date
  gender                String?           @db.VarChar(30)
  emergencyContactName  String?           @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?           @map("emergency_contact_phone") @db.VarChar(30)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  careRelationships     CareRelationship[]
  consents              Consent[]

  @@index([publicPatientId])
  @@map("patient_profiles")
}

enum CareRelationshipStatus {
  REQUESTED
  ACTIVE
  SUSPENDED
  TERMINATED
  REVOKED
}

model CareRelationship {
  id            String                 @id @default(uuid()) @db.Uuid
  patientId     String                 @map("patient_id") @db.Uuid
  patient       PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String                 @map("doctor_id") @db.Uuid
  doctor        DoctorProfile          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status        CareRelationshipStatus @default(ACTIVE)
  establishedAt DateTime?              @map("established_at") @db.Timestamptz(6)
  terminatedAt  DateTime?              @map("terminated_at") @db.Timestamptz(6)
  notes         String?                @db.Text
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  consents      Consent[]

  @@unique([patientId, doctorId], name: "patient_doctor_unique")
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([patientId, doctorId, status])
  @@map("care_relationships")
}

enum ConsentScope {
  PATIENT_PROFILE
  CONSULTATION_INFO
  PRE_CONSULTATION
  HEALTH_RECORDS
  HEALTH_TIMELINE
  WELLNESS
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ConsentAction {
  GRANTED
  REVOKED
  EXPIRED
  SCOPE_UPDATED
}

model Consent {
  id                 String           @id @default(uuid()) @db.Uuid
  patientId          String           @map("patient_id") @db.Uuid
  patient            PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String           @map("doctor_id") @db.Uuid
  doctor             DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  careRelationshipId String?          @map("care_relationship_id") @db.Uuid
  careRelationship   CareRelationship? @relation(fields: [careRelationshipId], references: [id], onDelete: SetNull)
  scope              ConsentScope
  status             ConsentStatus    @default(ACTIVE)
  purpose            String?          @db.Text
  grantedAt          DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedBy          String?          @map("revoked_by") @db.VarChar(128)
  revocationReason   String?          @map("revocation_reason") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  history            ConsentHistory[]

  @@index([patientId])
  @@index([doctorId])
  @@index([careRelationshipId])
  @@index([patientId, doctorId, scope, status])
  @@index([status])
  @@index([expiresAt])
  @@map("consents")
}

model ConsentHistory {
  id        String        @id @default(uuid()) @db.Uuid
  consentId String        @map("consent_id") @db.Uuid
  consent   Consent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  action    ConsentAction
  actorId   String        @map("actor_id") @db.VarChar(128)
  actorRole String        @map("actor_role") @db.VarChar(50)
  reason    String?       @db.Text
  metadata  String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consentId])
  @@index([actorId])
  @@index([createdAt])
  @@map("consent_histories")
}


