// ==============================================================================
// MANVIA — Prisma Schema (Phase 3 PostgreSQL + Prisma Foundation)
// ==============================================================================
// NOTICE: This schema establishes the infrastructure foundation only.
// In strict adherence to Phase 3 requirements, NO business domain models
// (User, Patient, Doctor, Appointment, HealthRecord, Consent, etc.) exist here.
// Future domain phases will author their respective models.
//
// Baseline:
// - PostgreSQL 18.x
// - Prisma 7.x
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
