# MANVIA Frontend Environment Configuration
# NOTE: Only intentionally public, client-safe variables prefixed with VITE_ may be defined here.
# NEVER place database credentials, secret keys, or private tokens in frontend environment files.

# Backend API Base URL (Fastify + NestJS Gateway)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Backend Health Check Base URL
VITE_BACKEND_URL=http://localhost:3000

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Application Public Title
VITE_APP_NAME=MANVIA
