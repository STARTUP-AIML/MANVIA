# ==============================================================================
# MANVIA — Environment Configuration Template (Root Reference)
# ==============================================================================
# See backend/.env.example for comprehensive field annotations.
# NEVER commit real secrets or production credentials.
# ==============================================================================

NODE_ENV=development
APP_NAME=manvia-backend
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
LOG_LEVEL=debug

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manvia_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=manvia:
REDIS_PASSWORD=

JWT_SECRET=placeholder-jwt-secret-min-32-chars-for-dev-only
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=placeholder-jwt-refresh-secret-min-32-chars-for-dev-only
JWT_REFRESH_EXPIRATION=7d

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_BUCKET=manvia-documents-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

OTEL_SERVICE_NAME=manvia-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false
